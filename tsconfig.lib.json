{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-lib",
    // Override rootDir from base — multiple source roots need rootDir at repo level
    "rootDir": ".",
    "lib": ["ES2023"],
    "declaration": true,
    "declarationDir": "./dist-lib",
    // jsx: inherit react-jsx from base (needed for duck files that use JSX)
    // We'll let tsc handle the tsx files from the duck layer
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Allow emitting JavaScript even when transitive UI files have type errors.
    // The library's own source (client/) and core backend (ts/session/, ts/models/ etc.)
    // are type-correct; errors in transitively-compiled React components don't affect
    // the library's runtime correctness.
    "noEmitOnError": false
  },
  "include": [
    "client/**/*.ts",
    "client/**/*.d.ts",
    "ts/session/**/*.ts",
    "ts/session/**/*.tsx",
    "ts/receiver/**/*.ts",
    "ts/models/**/*.ts",
    "ts/data/**/*.ts",
    // ts/node/**/*.ts intentionally removed: the broad glob included Electron-only files
    // (tray_icon, spell_check, permissions, etc.) that are not needed by the library.
    // Files actually imported by library code (sql.ts, dbVacuumManager.ts, etc.) are
    // still compiled via transitive imports — no explicit listing needed.
    // ts/util/**/*.ts intentionally removed: the broad glob included UI-only util files
    // (attachmentsUtil, accountManager, timer, theme, ctaHistory) that import from
    // ts/components/ and ts/themes/. All util files actually used by the library
    // are still compiled via transitive imports from session/, models/, receiver/ etc.
    "ts/shared/**/*.ts",
    "ts/types/**/*.ts",
    "ts/protobuf/**/*.ts",
    "ts/OS.ts",
    "ts/webworker/**/*.ts",
    // Pure-enum interaction types needed by ts/models/ (no React/Electron imports)
    "ts/interactions/types.ts",
    // Clean avatar-upload util needed by AvatarReuploadJob (no React/Electron imports)
    "ts/interactions/avatar-interactions/nts-avatar-interactions.ts",
    // Only the duck files that backend code imports action creators from
    "ts/state/ducks/conversations.ts",
    "ts/state/ducks/metaGroups.ts",
    "ts/state/ducks/onions.ts",
    "ts/state/ducks/settings.tsx",
    "ts/state/ducks/user.ts",
    "ts/state/ducks/userGroups.ts",
    "ts/state/ducks/proBackendData.ts",
    // modalDialog.tsx removed: imports React and is only used by ts/interactions/ (excluded),
    // not by any backend session/models code. Toast.tsx uses dynamic require for it.
    "ts/state/ducks/releasedFeatures.ts",
    "ts/state/ducks/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    "app",
    "ts/components/**",
    "ts/hooks/**",
    "ts/themes/**",
    "ts/mains/**",
    "ts/svgs/**",
    "ts/interactions/**",
    // keyboardShortcuts.ts imports React event types — UI-only, not needed by library
    "ts/util/keyboardShortcuts.ts",
    // UI-only util files that import from ts/components/ or ts/themes/
    "ts/util/index.ts",
    "ts/util/attachment/attachmentsUtil.ts",
    "ts/util/accountManager.ts",
    "ts/util/timer.ts",
    "ts/util/theme.ts",
    "ts/util/ctaHistory.ts",
    // Ambient .d.ts files that import from themes/ or updater/; replaced by client/lib/ versions
    "ts/window.d.ts",
    "ts/react.d.ts",
    "ts/state/createStore.ts",
    "ts/state/reducer.ts",
    "ts/state/selectors/**",
    "ts/state/startup.ts",
    "ts/state/smart/**",
    "ts/updater/**",
    "ts/test/**",
    "ts/webworker/workers/node/libsession/libsession.worker.ts",
    "ts/webworker/workers/node/image_processor/image_processor.worker.ts",
    "ts/webworker/workers/node/util/util.worker.ts",
    "dynamic_assets/**"
  ]
}
