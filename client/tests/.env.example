# Copy this file to client/tests/.env and fill in your credentials.
# The .env file is gitignored — never commit real mnemonics.
#
# All tests share the same variables. Set them once here and every
# test (send, listen, group, group-listen) picks them up automatically.

# -------------------------------------------------------------------
# Required
# -------------------------------------------------------------------

# 13-word mnemonic for your Session account
MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13

# Session ID of the recipient used by send.js and group.js (66-char hex starting with "05")
RECIPIENT_SESSION_ID=05xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Name of the group used by group.js, group-listen.js, and cleanup-groups.js
GROUP_NAME=Claw - Test


# -------------------------------------------------------------------
# Optional
# -------------------------------------------------------------------

# Where to store the database and keys for all tests
# DATA_PATH=./test_data

# Where to save downloaded attachments (listen.js, group-listen.js)
# DOWNLOADS_PATH=./test_data/downloads

# How long listen.js / group-listen.js waits for incoming messages (ms)
# TIMEOUT_MS=60000

# Log level: trace | debug | info | warn | error | silent
# LOG_LEVEL=warn

# How long to wait for config sync + onion paths before sending (ms)
# SYNC_WAIT_MS=15000

# How long to poll for 'sent' status (ms)
# SEND_WAIT_MS=20000

# How long to wait after createGroup() for the invite to reach the recipient (ms)
# INVITE_WAIT_MS=8000
